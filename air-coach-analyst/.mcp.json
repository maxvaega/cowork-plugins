{
  "mcpServers": {
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server", "--readOnly"],
      "env": {
        "MCP_CONNECTION_STRING": "${AIRCOACH_MONGODB_URI}"
      }
    },
    "auth0": {
      "command": "npx",
      "args": ["-y", "@auth0/auth0-mcp-server", "run"],
      "env": {
        "AUTH0_DOMAIN": "${AIRCOACH_AUTH0_DOMAIN}",
        "AUTH0_CLIENT_ID": "${AIRCOACH_AUTH0_CLIENT_ID}"
      }
    }
  }
}
